{
	"name": "crabby-bot",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "concurrently \"bun run --cwd packages/server dev\" \"bun run --cwd packages/client dev\" --names server,client --prefix-colors blue,green"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@cloudflare/workers-types": "^5.20260829.1",
		"@types/bun": "latest",
		"client": "workspace:*",
		"concurrently": "^10.0.5",
		"server": "workspace:*",
		"wrangler": "^4.127.1"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"workspaces": [
		"packages/*"
	]
}
